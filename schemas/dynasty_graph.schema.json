{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/historical_dynasty_graph.schema.json",
  "title": "DINASTÍA HISTÓRICA Ω — Genealogy / Prosopography / Control",
  "description": "Historical-only epistemic regime. Corporate ownership belongs to corporate_ownership_graph.schema.json and must not share confidence propagation.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/entity" },
    { "$ref": "#/$defs/relation" }
  ],
  "$defs": {
    "entityType": {
      "enum": ["person","surname","family","dynasty","branch","institution","territory","title","office","event","source"]
    },
    "grade": { "enum": ["A1","A2","B1","B2","C","X"] },
    "status": { "enum": ["accepted","provisional","disputed","rejected","unresolved"] },
    "relationType": {
      "enum": [
        "parent_of","child_of","sibling_of","spouse_of","grandparent_of","maternal_line_of","paternal_line_of","adopted_by",
        "member_of","head_of","branch_of","successor_of","predecessor_of","claims_descent_from","historiographically_derived_from","same_tohm_as","associated_with","allied_with","possible_same_as","same_as",
        "rules","holds_title","holds_office","inherits_office","served_under","participated_in",
        "holds_territory","controls_territory","inherits_territory","acquires_territory","purchases_territory","granted_to","confiscated_from",
        "transfers_patrimony","marriage_transfer","inherited_from","political_successor_of","office_transferred_to","office_displaced_by","based_in"
      ]
    },
    "entity": {
      "type": "object",
      "required": ["record_type","id","entity_type","name","status"],
      "properties": {
        "record_type": { "const": "entity" },
        "epistemic_domain": { "const": "historical" },
        "id": { "type": "string", "minLength": 3 },
        "entity_type": { "$ref": "#/$defs/entityType" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string" }, "default": [] },
        "house_id": { "type": ["string","null"] },
        "surname_id": { "type": ["string","null"] },
        "date_min": { "type": ["integer","null"] },
        "date_max": { "type": ["integer","null"] },
        "date_precision": { "enum": ["exact","year","approximate","range","unknown"] },
        "territory_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "title_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "status": { "$ref": "#/$defs/status" },
        "notes": { "type": "string", "default": "" },
        "provenance": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "additionalProperties": true
    },
    "relation": {
      "type": "object",
      "required": ["record_type","id","source_id","target_id","relation_type","evidence_grade","relation_basis","source_ids","confidence","status"],
      "properties": {
        "record_type": { "const": "relation" },
        "epistemic_domain": { "const": "historical" },
        "id": { "type": "string", "minLength": 3 },
        "source_id": { "type": "string" },
        "target_id": { "type": "string" },
        "relation_type": { "$ref": "#/$defs/relationType" },
        "evidence_grade": { "$ref": "#/$defs/grade" },
        "relation_basis": { "enum": ["explicit_primary","explicit_near_primary","later_tradition","modern_reconstruction","membership_only","inscription","sigillographic","numismatic","official_correspondence","inference","rejected_identification"] },
        "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "independence_root_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "source_temporality": { "enum": ["contemporary","near_contemporary","retrospective","disputed","mixed","unknown"] },
        "source_bias_flag": { "enum": ["none_known","patronal","dynastic","hagiographic","epic","political","mixed","unknown"] },
        "date_min": { "type": ["integer","null"] },
        "date_max": { "type": ["integer","null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "$ref": "#/$defs/status" },
        "notes": { "type": "string", "default": "" }
      },
      "additionalProperties": true
    }
  }
}
