{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmitOnError": true,
    "outDir": ".atlas-build",
    "rootDir": "src/atlas",
    "typeRoots": ["./mobile/node_modules/@types"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/atlas/**/*.ts"]
}
