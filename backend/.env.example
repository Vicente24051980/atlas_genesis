# ATLAS Ω Backend v0.3
PORT=8787
HOST=0.0.0.0
CACHE_TTL_MS=15000

# Market-data sensor. Backend secret only; NEVER expose in Expo EXPO_PUBLIC_* variables.
FINNHUB_TOKEN=

# SEC requires an identifying User-Agent with a real contact address.
SEC_USER_AGENT=ATLAS-Omega/0.3 your-email@example.com

# Trading 212 Public API. Create a key with READ-ONLY account/portfolio permissions.
# Backend code contains no order/write proxy and only permits fixed GET account/position paths.
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENV=live

# Mobile builds receive only the public backend URL, e.g. https://atlas-api.example.com
# EXPO_PUBLIC_ATLAS_API_BASE_URL belongs in the mobile/EAS build environment, not here.
