# Server
PORT=8787
HOST=0.0.0.0
CACHE_TTL_MS=15000

# Market data sensor. Keep this ONLY on the backend, never in Expo/mobile env.
FINNHUB_TOKEN=

# SEC asks automated clients to identify themselves with a descriptive User-Agent.
SEC_USER_AGENT=ATLAS-Omega/0.2 your-email@example.com

# Trading 212 is intentionally not enabled in this build until a key is created
# with read-only permissions (portfolio/account/history only, no order scope).
TRADING212_API_KEY=
TRADING212_API_SECRET=
