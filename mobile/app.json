{
  "expo": {
    "name": "ATLAS Ω",
    "slug": "atlas-omega-mobile",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "atlasomega",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": ["android"],
    "android": {
      "package": "com.vicentebellver.atlasomega",
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
